---
import '@porsche-design-system/components-js/index.css';
import { getComponentChunkLinks, getIconLinks, getLoaderScript, getMetaTagsAndIconLinks } from '@porsche-design-system/components-js/partials';

const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<!doctype html>
<html lang="en" class="scheme-light">
	<head>
		<meta charset="UTF-8" />
		<base href={baseUrl} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
		<link rel="icon" href={`${baseUrl}favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
        <!-- preloads the local PDS core chunk for component hydration -->
        <Fragment set:html={getComponentChunkLinks()} />
        <!-- preloads Porsche icons (=> minimize FOUC) -->
        <Fragment set:html={getIconLinks()} />
        <!-- injects favicon, apple touch icons, android touch icons, etc. -->
        <Fragment set:html={getMetaTagsAndIconLinks({ appTitle: 'Porsche' })} />
	</head>
	<body>
		<slot />
        <Fragment set:html={getLoaderScript()} />
	</body>
</html>

<style is:global>
	:not(:defined) {
		visibility: hidden;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
